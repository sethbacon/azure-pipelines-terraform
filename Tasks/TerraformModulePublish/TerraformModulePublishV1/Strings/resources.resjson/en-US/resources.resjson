{
  "loc.friendlyName": "Pipeline Terraform module publish",
  "loc.helpMarkDown": "[Learn more about this task](https://github.com/sethbacon/azure-pipelines-terraform)",
  "loc.description": "Publish a Terraform module version to HCP Terraform or a private Terraform registry",
  "loc.instanceNameFormat": "Publish module $(name) to $(registryType)",
  "loc.messages.InputRequired": "Input '%s' is required.",
  "loc.messages.SkipTlsVerifyEnabled": "skipTlsVerify is enabled: TLS certificate validation is DISABLED for the private registry connection, so the API key can be captured by an on-path attacker impersonating the registry. Use only for an internal registry fronted by a private CA the agent does not trust; prefer installing that CA via NODE_EXTRA_CA_CERTS instead.",
  "loc.messages.SkipTlsVerifyPublicRegistryRejected": "Refusing to disable TLS certificate validation (skipTlsVerify) against '%s': that destination is not provably private. skipTlsVerify is honoured only when registryUrl is a private/link-local/reserved address or resolves to one -- the case an internal registry fronted by a CA the agent does not trust actually is. The host is lowercased with a trailing dot stripped before the check (so 'app.terraform.io.' is the public registry, not a bypass), and a registryUrl that does not parse or that carries user:password@ credentials is refused outright. Install the private CA via NODE_EXTRA_CA_CERTS instead of disabling verification.",
  "loc.messages.UnsupportedRegistryType": "Unsupported registryType '%s'. Expected 'hcp' or 'private'.",
  "loc.messages.RegistryNonJsonResponse": "Registry returned a non-JSON response body: %s",
  "loc.messages.TransientHttpRetry": "Transient HTTP %s from registry; retrying (%s/%s).",
  "loc.messages.TransientRequestFailureRetry": "Transient request failure (%s); retrying (%s/%s).",
  "loc.messages.HttpsRequired": "Refusing to send credentials over a non-HTTPS URL (scheme '%s//' on host '%s'). Use an https:// URL.",
  "loc.messages.ResponseTooLarge": "Response from %s exceeded %s bytes.",
  "loc.messages.RequestTimedOut": "Request to %s timed out after %sms.",
  "loc.messages.HcpVersionAlreadyReady": "Version %s already exists and is ready.",
  "loc.messages.HcpVersionAlreadyReadyFail": "Version %s already exists and is ready, and existingVersion is 'fail'. Choose a new version, or set existingVersion to 'skip' to treat this as already published.",
  "loc.messages.HcpUnsupportedExistingVersion": "Unsupported existingVersion '%s'. Expected one of: %s.",
  "loc.messages.HcpCheckOnlyModuleMissing": "Check only: module %s/%s/%s does not exist; a publish would create it as a '%s' module. Nothing was changed.",
  "loc.messages.HcpCheckOnlyVersionAbsent": "Check only: version %s is not ready; a publish would create it on this '%s' module. Nothing was changed.",
  "loc.messages.HcpCheckOnlyFailed": "Check only: could not read the module (HTTP %s), so nothing can be reported. Check the token and address.",
  "loc.messages.HcpUnsupportedPublishMode": "Unsupported hcpPublishMode '%s'. Expected one of: %s.",
  "loc.messages.HcpPublishModeMismatch": "hcpPublishMode is '%s' but module %s/%s/%s is a '%s' module. Set hcpPublishMode to match it, or to 'auto'.",
  "loc.messages.HcpVcsRepoNameMismatch": "HCP names a VCS-connected module from its repository, so '%s' would create the module '%s' for provider '%s', not '%s' for provider '%s'. Set name and provider to match the repository (terraform-<provider>-<name>), or use a repository with the intended name.",
  "loc.messages.HcpVcsInputsIncomplete": "Module does not exist and only one of vcsRepoIdentifier / vcsOauthTokenId is set; %s is missing. Set both to create a VCS-connected module, or neither to create a module with no VCS connection.",
  "loc.messages.HcpVcsModeNeedsInputs": "hcpPublishMode '%s' needs both vcsRepoIdentifier and vcsOauthTokenId to create the module, which does not exist yet.",
  "loc.messages.HcpVcsBranchRequired": "hcpPublishMode 'vcsBranch' needs vcsBranch to be set. Use 'vcsTag' for a tag-based module.",
  "loc.messages.HcpVcsInputsIgnored": "hcpPublishMode is 'upload', so vcsRepoIdentifier / vcsOauthTokenId are ignored and the module is created with no VCS connection.",
