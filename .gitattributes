Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/tofu_1.6.0_SHA256SUMS -text
Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/tofu_1.6.0_SHA256SUMS.gpgsig -text
