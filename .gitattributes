# The HashiCorp trust-root canary fixtures (#497) are byte-for-byte GPG-signed
# content: SHA256SUMS is signed over its exact bytes (LF line endings), and
# SHA256SUMS.sig is a binary OpenPGP signature. Git's default CRLF conversion on
# Windows checkouts corrupts the signed text (breaking gpg-verifier's signature
# check even though the committed blob is correct), so both are pinned to their
# exact on-disk bytes regardless of platform/core.autocrlf.
Tasks/PolicyAgentInstaller/PolicyAgentInstallerV1/Tests/fixtures/terraform_1.15.8_SHA256SUMS -text
Tasks/PolicyAgentInstaller/PolicyAgentInstallerV1/Tests/fixtures/terraform_1.15.8_SHA256SUMS.sig -text
# The same canary fixtures ported into TerraformInstallerV1's own suite (#497) so
# its CI job independently exercises its byte-identical copy of the crypto path.
Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/terraform_1.15.8_SHA256SUMS -text
Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/terraform_1.15.8_SHA256SUMS.sig -text
# A release signed BEFORE HashiCorp re-certified the key (2026-02-18), replayed
# beside the one above so both generations of the key's self-signature stay
# embedded. Same byte-exactness requirement, in both installers' suites.
Tasks/PolicyAgentInstaller/PolicyAgentInstallerV1/Tests/fixtures/terraform_1.5.7_SHA256SUMS -text
Tasks/PolicyAgentInstaller/PolicyAgentInstallerV1/Tests/fixtures/terraform_1.5.7_SHA256SUMS.sig -text
Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/terraform_1.5.7_SHA256SUMS -text
Tasks/TerraformInstaller/TerraformInstallerV1/Tests/fixtures/terraform_1.5.7_SHA256SUMS.sig -text
# OpenTofu's counterparts: downloadSource=registry verifies the detached .gpgsig OpenTofu
